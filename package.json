{
  "name": "catalogo-enoboutique",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copiar-zxing.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copiar-zxing.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:produccion": "playwright test --config playwright.produccion.config.ts",
    "db:migrar": "node scripts/migrar.mjs",
    "db:tipos": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" --schema public > lib/tipos-db.ts",
    "db:seed": "node scripts/seed.mjs",
    "db:mails": "node scripts/configurar-mails.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "barcode-detector": "^3.2.3",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@next/env": "^16.4.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "supabase": "^2.122.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
