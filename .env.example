# Copiá este archivo como .env.local y completalo con los datos del proyecto de
# Supabase de desarrollo. .env.local nunca se sube al repositorio.

# Project Settings → Data API (o botón "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Solo para tests y migraciones. Nunca se usan en el código de la app. ---
# Project Settings → API Keys → Secret key (sb_secret_...). Saltea RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Avatar → Account preferences → Access Tokens (sbp_...)
SUPABASE_ACCESS_TOKEN=
# Las 20 letras de la URL del proyecto: supabase.com/dashboard/project/<project-ref>
SUPABASE_PROJECT_REF=
# Contraseña de la base, elegida al crear el proyecto (para `supabase db push`)
SUPABASE_DB_PASSWORD=

# Opcional: Chromium ya instalado para Playwright (ej.: /opt/pw-browsers/chromium)
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
