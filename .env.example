# Copiá este archivo como .env.local y completalo con los datos del proyecto de
# Supabase de desarrollo. .env.local nunca se sube al repositorio.

# Project Settings → Data API (o botón "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Project Settings → API Keys → Publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Solo para tests y migraciones. Nunca se usan en el código de la app. ---
# Project Settings → API Keys → Secret key (sb_secret_...). Saltea RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Avatar → Account preferences → Access Tokens (sbp_...)
SUPABASE_ACCESS_TOKEN=
# Las 20 letras de la URL del proyecto: supabase.com/dashboard/project/<project-ref>
SUPABASE_PROJECT_REF=
# Contraseña de la base, elegida al crear el proyecto (para `supabase db push`)
SUPABASE_DB_PASSWORD=

# Opcional: en entornos con proxy de red, servir las fotos sin optimizar (1 = sí)
# IMAGENES_SIN_OPTIMIZAR=

# Opcional: Chromium ya instalado para Playwright (ej.: /opt/pw-browsers/chromium)
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=

# Spec 007: sugerencias por IA (Gemini). La clave la carga cada uno; nunca en el código.
GEMINI_API_KEY=
# Opcional: otro modelo de Gemini (por defecto, gemini-3.8-flash).
IA_MODELO=
# 1 = IA de prueba (tests y previews sin clave; no gasta nada).
IA_FALSA=
# Clave para que el cron del hosting procese la cola de sugerencias (/api/sugerencias/procesar).
CRON_SECRET=

# Spec 009: proyecto de Supabase de PRODUCCIÓN, solo para los scripts db:* con --produccion
# (piden confirmación). Los tests y los previews nunca lo usan.
SUPABASE_PROJECT_REF_PRODUCCION=
